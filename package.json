    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "openg2p",
    "notification",
    "inbox"
  ],
  "dependencies": {
    "@novu/js": "^3.19.2",
    "lucide-react": "^0.555.0"
